# bench-baseline.php 설정 템플릿
#   cp bench.env.example bench.env  후 값을 채운다. bench.env 는 커밋하지 않는다.

# 측정 대상 앱. 운영 기준선은 images, 개선 측정은 images2 로 바꿔 가며 실행한다.
APP_BASE=https://images.example.com

# MinIO 직접 GET 용 베이스 (path-style: {endpoint}/{bucket}).
# 익명 읽기가 막혀 있으면 비워 두면 A 경로를 건너뛴다.
# 비우면 "PHP/FPM 오버헤드" 분해값을 얻을 수 없으므로 가능하면 채울 것.
MINIO_DIRECT_BASE=https://storage.example.com/orderhow

# URL 첫 세그먼트로 쓰이는 버킷명
BUCKET=orderhow

# 실재하는 원본 오브젝트 키. 대표적인 크기(수백 KB 이상)를 고른다.
SAMPLE_PATH=products/2026/01/sample.jpg

# preview 가 이미 존재하는 크기 (C 경로). 로그 상위 크기에서 고른다.
HIT_SIZE=300x300

# D 경로에서 미스를 강제할 시작 폭. runs 만큼 1씩 증가시킨다.
# 운영에서 실제로 안 쓰는 대역을 고를 것. 측정 후 정리 명령이 출력된다.
MISS_WIDTH_BASE=1900

# images2 에 Basic Auth 를 걸었다면 user:pass
AUTH=
